# Momentum intentionally works without any cloud API key.
# Real state defaults to ~/.momentum-mcp/momentum.db.

# Optional: choose a different LOCAL directory outside this repository.
# MOMENTUM_HOME=/absolute/path/outside/the/repository

# Set only for development if you intentionally want metadata-only debug logs.
MOMENTUM_DEBUG=0

# Safety escape hatch. Do not enable for normal use.
# MOMENTUM_ALLOW_REPO_DB=0
